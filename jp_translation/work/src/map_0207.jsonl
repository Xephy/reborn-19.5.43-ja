{"sec": "map:207", "key": "\\PN obtained PULSE Read-Out 06!", "en": "\\PN obtained PULSE Read-Out 06!", "ja": "\\PNはPULSEデータ06を手に入れた!"}
{"sec": "map:207", "key": "PULSE Dex updated!", "en": "PULSE Dex updated!", "ja": "PULSE図鑑が更新された!"}
{"sec": "map:207", "key": "...A visitor.", "en": "...A visitor.", "ja": "……来客か。"}
{"sec": "map:207", "key": "...Kay.", "en": "...Kay.", "ja": "……オーケー。"}
{"sec": "map:207", "key": "...", "en": "...", "ja": "…………"}
{"sec": "map:207", "key": "...Bring me a Chimecho.", "en": "...Bring me a Chimecho.", "ja": "……チリーンを持ってこい。"}
{"sec": "map:207", "key": "...No.", "en": "...No.", "ja": "……ダメだ。"}
{"sec": "map:207", "key": "...Chimecho.", "en": "...Chimecho.", "ja": "……チリーン。"}
{"sec": "map:207", "key": "...Chime.", "en": "...Chime.", "ja": "……チリン。"}
{"sec": "map:207", "key": "...Yes, good.", "en": "...Yes, good.", "ja": "……そう、それでいい。"}
{"sec": "map:207", "key": "...I caught something.", "en": "...I caught something.", "ja": "……何か捕まえた。"}
{"sec": "map:207", "key": "...It didn't help, so I locked it in the basement.", "en": "...It didn't help, so I locked it in the basement.", "ja": "……役に立たなかったから、地下に閉じ込めた。"}
{"sec": "map:207", "key": "...Only Chimecho helps.", "en": "...Only Chimecho helps.", "ja": "……チリーンだけが、役に立つ。"}
{"sec": "map:207", "key": "...Heals.", "en": "...Heals.", "ja": "……癒やす。"}
{"sec": "map:207", "key": "...Nothing else ever, ever helps.", "en": "...Nothing else ever, ever helps.", "ja": "……他には、何も、何も役に立たない。"}
{"sec": "map:207", "key": "...Go ahead, check the basement.", "en": "...Go ahead, check the basement.", "ja": "……ほら、地下を見てくるといい。"}
